<!--
    Controls.xaml — surfaces, textes, boutons et puces du design system v5.
    Toutes les valeurs viennent de Tokens.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:anim="using:Canopus.App.Animations">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         OMBRES — AttachedCardShadow masque l'ombre sous la card, sinon
         elle transparaîtrait à travers l'aplat translucide.
         ============================================================ -->
    <media:AttachedCardShadow x:Key="ShadowL1"
                              BlurRadius="{StaticResource ShadowL1BlurRadius}"
                              Color="{StaticResource ShadowColor}"
                              Opacity="{StaticResource ShadowL1Opacity}"
                              Offset="{StaticResource ShadowL1Offset}"
                              CornerRadius="{StaticResource RadiusCardValue}" />

    <media:AttachedCardShadow x:Key="ShadowL2"
                              BlurRadius="{StaticResource ShadowL2BlurRadius}"
                              Color="{StaticResource ShadowColor}"
                              Opacity="{StaticResource ShadowL2Opacity}"
                              Offset="{StaticResource ShadowL2Offset}"
                              CornerRadius="{StaticResource RadiusCardValue}" />

    <media:AttachedCardShadow x:Key="ShadowAccentButton"
                              BlurRadius="{StaticResource ShadowAccentBlurRadius}"
                              Color="{StaticResource AccentShadowColor}"
                              Opacity="{StaticResource ShadowAccentOpacity}"
                              Offset="{StaticResource ShadowAccentOffset}"
                              CornerRadius="{StaticResource RadiusControlValue}" />

    <media:AttachedCardShadow x:Key="ShadowAccentHeroButton"
                              BlurRadius="{StaticResource ShadowAccentBlurRadius}"
                              Color="{StaticResource AccentShadowColor}"
                              Opacity="{StaticResource ShadowAccentOpacity}"
                              Offset="{StaticResource ShadowAccentOffset}"
                              CornerRadius="{StaticResource RadiusHeroButtonValue}" />

    <media:AttachedCardShadow x:Key="ShadowSegmentThumb"
                              BlurRadius="{StaticResource ShadowThumbBlurRadius}"
                              Color="{StaticResource ShadowColor}"
                              Opacity="{StaticResource ShadowThumbOpacity}"
                              Offset="{StaticResource ShadowThumbOffset}"
                              CornerRadius="{StaticResource RadiusSegmentThumbValue}" />

    <!-- ============================================================
         SURFACES
         Niveau 2 : l'élément principal de l'écran, un seul par écran.
         Niveau 1 : les cards secondaires. Niveau 0 : posé sur la fenêtre.
         ============================================================ -->
    <Style x:Key="SurfaceNavStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceNavBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceNavStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusNav}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="SurfaceL1CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceL1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceL1StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="ui:Effects.Shadow" Value="{StaticResource ShadowL1}" />
    </Style>

    <Style x:Key="SurfaceL2CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceL2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceL2StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="ui:Effects.Shadow" Value="{StaticResource ShadowL2}" />
    </Style>

    <Style x:Key="DividerStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource DividerBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ============================================================
         TEXTES — une famille par graisse, voir Tokens.xaml
         ============================================================ -->
    <Style x:Key="TextSemiBoldStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize14}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBoldStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBold}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="TextExtraBoldStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize24}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackingHeading}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="HeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize30}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackingTitle}" />
    </Style>

    <Style x:Key="GroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize22}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize16}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DisplayValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize72}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackingDisplay}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextLineBounds" Value="TrimToBaseline" />
    </Style>

    <Style x:Key="DisplayUnitStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize24}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextLineBounds" Value="TrimToBaseline" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize36}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource TrackingTitle}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextLineBounds" Value="TrimToBaseline" />
    </Style>

    <Style x:Key="MetricUnitStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize15}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextLineBounds" Value="TrimToBaseline" />
    </Style>

    <!-- Intitulé de ligne : réglage, élément de liste -->
    <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize15}" />
    </Style>

    <Style x:Key="RowTitleStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize15}" />
    </Style>

    <!-- Valeur secondaire en gras (charge, gigue, fréquence) -->
    <Style x:Key="LabelStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBoldStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Texte descriptif -->
    <Style x:Key="BodyStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize15}" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="CaptionStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ============================================================
         PUCE DE STATUT
         ============================================================ -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextExtraBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize12}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         BOUTONS
         ============================================================ -->
    <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              anim:BackgroundTransition.IsEnabled="True"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource AccentHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource AccentPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="{StaticResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              anim:BackgroundTransition.IsEnabled="True"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="{StaticResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="GhostButtonTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              anim:BackgroundTransition.IsEnabled="True"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource GhostHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource GhostHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="{StaticResource DisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="CanopusButtonBaseStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="{StaticResource FontSize14}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="anim:PressFeedback.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CanopusButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="ui:Effects.Shadow" Value="{StaticResource ShadowAccentButton}" />
    </Style>

    <Style x:Key="PrimarySmallButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="ui:Effects.Shadow" Value="{x:Null}" />
    </Style>

    <Style x:Key="HeroButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize16}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusHeroButton}" />
        <Setter Property="ui:Effects.Shadow" Value="{StaticResource ShadowAccentHeroButton}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CanopusButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="SecondarySmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource CanopusButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- ============================================================
         INTERRUPTEUR — ressources légères du ToggleSwitch natif
         ============================================================ -->
    <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="TransparentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="GhostHoverBrush" />
    <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="GhostHoverBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOffPressed" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOff" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOffPointerOver" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOffPressed" ResourceKey="TextTertiaryBrush" />
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="TextOnAccentBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="TextOnAccentBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="TextOnAccentBrush" />

    <Style x:Key="BareToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         SÉLECTEUR SEGMENTÉ (langue)
         ============================================================ -->
    <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource CanopusButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSegmentThumb}" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SegmentLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SegmentLabelActiveStyle" TargetType="TextBlock" BasedOn="{StaticResource SegmentLabelStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- ============================================================
         NAVIGATION — le fond de l'item actif est un indicateur séparé
         qui glisse (Sidebar.xaml.cs)
         ============================================================ -->
    <ControlTemplate x:Key="NavItemTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              anim:BackgroundTransition.IsEnabled="True"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource NavItemHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Background" Value="{StaticResource NavItemPressedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="NavItemStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource NavItemTemplate}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="NavLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TextSemiBoldStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="NavLabelActiveStyle" TargetType="TextBlock" BasedOn="{StaticResource NavLabelStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyExtraBold}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="NavIconStyle" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="{StaticResource IconStrokeThickness}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

</ResourceDictionary>
