<!--
    Tokens.xaml — design system Canopus v5, palette Dragée, dosage 1c.
    Référence : docs/design/Canopus_DS_v5.html (section 6).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         MATÉRIAU DE FENÊTRE (DesktopAcrylicController, Kind Base)
         ============================================================ -->
    <Color x:Key="BackdropTintColor">#FFFAF0F8</Color>
    <x:Double x:Key="BackdropTintOpacity">0</x:Double>
    <x:Double x:Key="BackdropLuminosityOpacity">0.75</x:Double>
    <Color x:Key="BackdropFallbackColor">#FFE9DFE7</Color>
    <SolidColorBrush x:Key="BackdropFallbackBrush" Color="{StaticResource BackdropFallbackColor}" />

    <!-- ============================================================
         PALETTE DRAGÉE — texte
         ============================================================ -->
    <Color x:Key="TextPrimaryColor">#FF3E1240</Color>
    <Color x:Key="TextSecondaryColor">#FF6A4466</Color>
    <Color x:Key="TextTertiaryColor">#FF6F4C6B</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />

    <!-- ============================================================
         PALETTE DRAGÉE — accent
         ============================================================ -->
    <Color x:Key="AccentColor">#FF8E2A82</Color>
    <Color x:Key="AccentHoverColor">#FFA03394</Color>
    <Color x:Key="AccentPressedColor">#FF76216C</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <!-- ============================================================
         NAVIGATION
         ============================================================ -->
    <Color x:Key="NavItemActiveColor">#FFFFD6F9</Color>
    <Color x:Key="NavItemHoverColor">#99FFFFFF</Color>
    <Color x:Key="NavItemPressedColor">#FFF7C4EF</Color>

    <SolidColorBrush x:Key="NavItemActiveBrush" Color="{StaticResource NavItemActiveColor}" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="{StaticResource NavItemHoverColor}" />
    <SolidColorBrush x:Key="NavItemPressedBrush" Color="{StaticResource NavItemPressedColor}" />
    <SolidColorBrush x:Key="NavMarkerBrush" Color="{StaticResource TextPrimaryColor}" />

    <!-- ============================================================
         STATUTS — « Normal » et « Confirmé » n'ont pas de couleur
         ============================================================ -->
    <Color x:Key="StatusWarnTextColor">#FF7A5104</Color>
    <Color x:Key="StatusWarnBgColor">#FFFBEBCC</Color>
    <Color x:Key="StatusBadTextColor">#FFA02C1A</Color>
    <Color x:Key="StatusBadBgColor">#FFFBE1DA</Color>
    <Color x:Key="StatusInfoTextColor">#FF5E4E5C</Color>
    <Color x:Key="StatusExcludedBgColor">#80FFFFFF</Color>

    <SolidColorBrush x:Key="StatusWarnTextBrush" Color="{StaticResource StatusWarnTextColor}" />
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBgColor}" />
    <SolidColorBrush x:Key="StatusBadTextBrush" Color="{StaticResource StatusBadTextColor}" />
    <SolidColorBrush x:Key="StatusBadBgBrush" Color="{StaticResource StatusBadBgColor}" />
    <SolidColorBrush x:Key="StatusInfoTextBrush" Color="{StaticResource StatusInfoTextColor}" />
    <SolidColorBrush x:Key="StatusNeutralTextBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="StatusIdleTextBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="StatusActiveTextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="StatusActiveBgBrush" Color="{StaticResource NavItemActiveColor}" />
    <SolidColorBrush x:Key="StatusExcludedTextBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="StatusExcludedBgBrush" Color="{StaticResource StatusExcludedBgColor}" />

    <!-- ============================================================
         DONNÉES — barres interdites au niveau 0
         ============================================================ -->
    <Color x:Key="DataBarColor">#FFC25AB0</Color>
    <Color x:Key="DataBarStrongColor">#FF8E2A82</Color>
    <Color x:Key="DataTrackColor">#8CFFFFFF</Color>

    <!-- Niveau 2 -->
    <SolidColorBrush x:Key="DataBarBrush" Color="{StaticResource DataBarColor}" />
    <!-- Niveau 1 : #C25AB0 tombe à 2,8:1 sur fond noir, d'où l'encre accent -->
    <SolidColorBrush x:Key="DataBarStrongBrush" Color="{StaticResource DataBarStrongColor}" />
    <SolidColorBrush x:Key="DataTrackBrush" Color="{StaticResource DataTrackColor}" />

    <!-- ============================================================
         FILETS ET CONTRÔLES
         ============================================================ -->
    <Color x:Key="DividerColor">#1A3E1240</Color>
    <Color x:Key="DividerStrongColor">#1F3E1240</Color>
    <Color x:Key="ControlStrokeColor">#293E1240</Color>
    <Color x:Key="GhostHoverColor">#80FFFFFF</Color>
    <Color x:Key="SecondaryButtonColor">#B3FFFFFF</Color>
    <Color x:Key="SecondaryButtonHoverColor">#FFFFFFFF</Color>
    <Color x:Key="SegmentTrackColor">#8CFFFFFF</Color>
    <Color x:Key="SegmentThumbColor">#FFFFFFFF</Color>
    <Color x:Key="CheckboxUncheckedColor">#B3FFFFFF</Color>
    <Color x:Key="TransparentColor">#00FFFFFF</Color>

    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="DividerStrongBrush" Color="{StaticResource DividerStrongColor}" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="{StaticResource GhostHoverColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{StaticResource SecondaryButtonHoverColor}" />
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="{StaticResource SegmentTrackColor}" />
    <SolidColorBrush x:Key="SegmentThumbBrush" Color="{StaticResource SegmentThumbColor}" />
    <SolidColorBrush x:Key="CheckboxUncheckedBrush" Color="{StaticResource CheckboxUncheckedColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}" />

    <!-- ============================================================
         BARRE DE TITRE (boutons système, réglés via AppWindow.TitleBar)
         ============================================================ -->
    <Color x:Key="TitleBarButtonForegroundColor">#FF3E1240</Color>
    <Color x:Key="TitleBarButtonHoverBackgroundColor">#80FFFFFF</Color>
    <Color x:Key="TitleBarButtonPressedBackgroundColor">#B3FFFFFF</Color>
    <Color x:Key="TitleBarButtonInactiveForegroundColor">#993E1240</Color>

    <!-- ============================================================
         SURFACES — aplats translucides, le flou vient de la fenêtre.
         Liseré : 1 px clair en haut, plus discret ailleurs (dégradé en
         coordonnées absolues pour que la transition tienne dans le 1er px).
         ============================================================ -->
    <Color x:Key="SurfaceNavColor">#33FFF7FD</Color>
    <Color x:Key="SurfaceNavStrokeTopColor">#B3FFFFFF</Color>
    <Color x:Key="SurfaceNavStrokeBottomColor">#40FFFFFF</Color>

    <Color x:Key="SurfaceL1Color">#80FFFFFF</Color>
    <Color x:Key="SurfaceL1StrokeTopColor">#CCFFFFFF</Color>
    <Color x:Key="SurfaceL1StrokeBottomColor">#4DFFFFFF</Color>

    <Color x:Key="SurfaceL2Color">#BFFFFFFF</Color>
    <Color x:Key="SurfaceL2StrokeTopColor">#F2FFFFFF</Color>
    <Color x:Key="SurfaceL2StrokeBottomColor">#80FFFFFF</Color>

    <SolidColorBrush x:Key="SurfaceNavBrush" Color="{StaticResource SurfaceNavColor}" />
    <SolidColorBrush x:Key="SurfaceL1Brush" Color="{StaticResource SurfaceL1Color}" />
    <SolidColorBrush x:Key="SurfaceL2Brush" Color="{StaticResource SurfaceL2Color}" />

    <LinearGradientBrush x:Key="SurfaceNavStrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <GradientStop Color="{StaticResource SurfaceNavStrokeTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceNavStrokeBottomColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceL1StrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <GradientStop Color="{StaticResource SurfaceL1StrokeTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceL1StrokeBottomColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceL2StrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <GradientStop Color="{StaticResource SurfaceL2StrokeTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceL2StrokeBottomColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         OMBRES (AttachedCardShadow, masquée sous la card). Le volet n'en a pas.
         ============================================================ -->
    <Color x:Key="ShadowColor">#FF3E1240</Color>
    <Color x:Key="AccentShadowColor">#FF8E2A82</Color>

    <x:Double x:Key="ShadowL1BlurRadius">16</x:Double>
    <x:Double x:Key="ShadowL1Opacity">0.08</x:Double>
    <x:String x:Key="ShadowL1Offset">0,4,0</x:String>

    <x:Double x:Key="ShadowL2BlurRadius">32</x:Double>
    <x:Double x:Key="ShadowL2Opacity">0.12</x:Double>
    <x:String x:Key="ShadowL2Offset">0,12,0</x:String>

    <x:Double x:Key="ShadowAccentBlurRadius">12</x:Double>
    <x:Double x:Key="ShadowAccentOpacity">0.28</x:Double>
    <x:String x:Key="ShadowAccentOffset">0,4,0</x:String>

    <x:Double x:Key="ShadowThumbBlurRadius">8</x:Double>
    <x:Double x:Key="ShadowThumbOpacity">0.10</x:Double>
    <x:String x:Key="ShadowThumbOffset">0,2,0</x:String>

    <!-- ============================================================
         RAYONS
         ============================================================ -->
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <x:Double x:Key="RadiusCardValue">16</x:Double>
    <CornerRadius x:Key="RadiusNav">12</CornerRadius>
    <CornerRadius x:Key="RadiusHeroButton">12</CornerRadius>
    <x:Double x:Key="RadiusHeroButtonValue">12</x:Double>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <x:Double x:Key="RadiusControlValue">10</x:Double>
    <CornerRadius x:Key="RadiusSegmentThumb">8</CornerRadius>
    <x:Double x:Key="RadiusSegmentThumbValue">8</x:Double>
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusCheckbox">4</CornerRadius>
    <!-- Barres : moitié exacte de la hauteur (8 et 6 px). Un rayon plus grand
         que la moitié de l'élément donne des arcs en pointe dans WinUI. -->
    <CornerRadius x:Key="RadiusBar">4</CornerRadius>
    <CornerRadius x:Key="RadiusBarThin">3</CornerRadius>
    <CornerRadius x:Key="RadiusNavMarker">1.5</CornerRadius>

    <!-- ============================================================
         TYPOGRAPHIE
         ============================================================ -->
    <x:Double x:Key="FontSize12">12</x:Double>
    <x:Double x:Key="FontSize13">13</x:Double>
    <x:Double x:Key="FontSize14">14</x:Double>
    <x:Double x:Key="FontSize15">15</x:Double>
    <x:Double x:Key="FontSize16">16</x:Double>
    <x:Double x:Key="FontSize20">20</x:Double>
    <x:Double x:Key="FontSize22">22</x:Double>
    <x:Double x:Key="FontSize24">24</x:Double>
    <x:Double x:Key="FontSize30">30</x:Double>
    <x:Double x:Key="FontSize36">36</x:Double>
    <x:Double x:Key="FontSize48">48</x:Double>
    <x:Double x:Key="FontSize72">72</x:Double>

    <!-- Interlettrage en millièmes d'em (CharacterSpacing) -->
    <x:Int32 x:Key="TrackingDisplay">-40</x:Int32>
    <x:Int32 x:Key="TrackingTitle">-20</x:Int32>
    <x:Int32 x:Key="TrackingHeading">-10</x:Int32>

    <x:Double x:Key="DisabledOpacity">0.5</x:Double>
    <x:Double x:Key="InactiveTitleOpacity">0.6</x:Double>

    <x:Double x:Key="IconStrokeThickness">1.8</x:Double>
    <x:Double x:Key="IconStrokeThicknessBold">2.4</x:Double>

    <!-- ============================================================
         POLICES
         Nunito statique (OFL, Assets/Fonts/OFL.txt). Une famille par graisse :
         un FontFamily pointant sur un seul fichier ne contient que cette
         graisse, WinUI synthétiserait les autres.
         ============================================================ -->
    <FontFamily x:Key="FontFamilySemiBold">ms-appx:///Assets/Fonts/Nunito-SemiBold.ttf#Nunito</FontFamily>
    <FontFamily x:Key="FontFamilyBold">ms-appx:///Assets/Fonts/Nunito-Bold.ttf#Nunito</FontFamily>
    <FontFamily x:Key="FontFamilyExtraBold">ms-appx:///Assets/Fonts/Nunito-ExtraBold.ttf#Nunito</FontFamily>

    <!-- ============================================================
         MOUVEMENT — durées en ms, easings en points de contrôle
         cubic-bezier « x1,y1,x2,y2 ». Tout passe à 0 si les animations
         Windows sont désactivées (voir Motion/MotionTokens.cs).
         ============================================================ -->
    <x:Double x:Key="MotionDurationPageExit">100</x:Double>
    <x:Double x:Key="MotionDurationPageEnter">250</x:Double>
    <x:Double x:Key="MotionStaggerStep">40</x:Double>
    <x:Double x:Key="MotionEnterOffset">12</x:Double>
    <x:Double x:Key="MotionDurationBar">600</x:Double>
    <x:Double x:Key="MotionBarDelay">120</x:Double>
    <x:Double x:Key="MotionDurationNav">250</x:Double>
    <x:Double x:Key="MotionDurationNavLong">350</x:Double>
    <x:Double x:Key="MotionNavLongDistance">200</x:Double>
    <x:Double x:Key="MotionDurationFast">150</x:Double>
    <x:Double x:Key="MotionDurationPress">83</x:Double>
    <x:Double x:Key="MotionPressScale">0.98</x:Double>
    <x:Double x:Key="MotionDurationSegment">250</x:Double>
    <!-- Écart minimal (en points de %) pour animer une barre au rafraîchissement -->
    <x:Double x:Key="MotionBarMinDelta">1</x:Double>

    <x:String x:Key="MotionEasingEnter">0,0,0,1</x:String>
    <x:String x:Key="MotionEasingExit">0.4,0,1,1</x:String>
    <x:String x:Key="MotionEasingStandard">0.2,0,0,1</x:String>

</ResourceDictionary>
