<!--
    Tokens.xaml — traduction des tokens du design system Claude Design
    (source : fichier consolidé, cf. Notion "Documentation technique")
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         COULEURS — Accent
         ============================================================ -->
    <Color x:Key="AccentColor">#7C84E0</Color>
    <Color x:Key="AccentLightColor">#9BA3EE</Color>
    <Color x:Key="AccentDarkColor">#5C64C9</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />

    <!-- ============================================================
         COULEURS — Fond (dégradé principal de l'app)
         Reproduit linear-gradient(135deg, #DDEFF7 0%, #DDEFF7 52%, #E6ECF9 74%, #EFE8F5 100%)
         ============================================================ -->
    <Color x:Key="BackgroundBlueColor">#DDEFF7</Color>
    <Color x:Key="BackgroundLavenderColor">#E6ECF9</Color>
    <Color x:Key="BackgroundPinkColor">#EFE8F5</Color>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BackgroundBlueColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource BackgroundBlueColor}" Offset="0.52" />
        <GradientStop Color="{StaticResource BackgroundLavenderColor}" Offset="0.74" />
        <GradientStop Color="{StaticResource BackgroundPinkColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============================================================
         COULEURS — Texte (hiérarchie à 4 paliers)
         ============================================================ -->
    <Color x:Key="TextPrimaryColor">#3A4A63</Color>
    <!-- Titres -->
    <Color x:Key="TextSecondaryColor">#4B5A74</Color>
    <!-- Corps de texte -->
    <Color x:Key="TextTertiaryColor">#8593AB</Color>
    <!-- Labels, légendes -->
    <Color x:Key="TextDisabledColor">#9AA6BE</Color>
    <!-- Désactivé / inactif -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- ============================================================
         COULEURS SÉMANTIQUES — 3 paliers par statut (texte / mid / fond clair)
         ============================================================ -->
    <!-- Confirmé / Stable / Bonne santé -->
    <Color x:Key="StatusGoodTextColor">#3E6B54</Color>
    <Color x:Key="StatusGoodMidColor">#4E9E74</Color>
    <Color x:Key="StatusGoodBgColor">#A8D5BA</Color>
    <SolidColorBrush x:Key="StatusGoodTextBrush" Color="{StaticResource StatusGoodTextColor}" />
    <SolidColorBrush x:Key="StatusGoodMidBrush" Color="{StaticResource StatusGoodMidColor}" />
    <SolidColorBrush x:Key="StatusGoodBgBrush" Color="{StaticResource StatusGoodBgColor}" />

    <!-- À vérifier / Élevé -->
    <Color x:Key="StatusWarnTextColor">#8A6A38</Color>
    <Color x:Key="StatusWarnMidColor">#C79433</Color>
    <Color x:Key="StatusWarnBgColor">#F5D9A8</Color>
    <SolidColorBrush x:Key="StatusWarnTextBrush" Color="{StaticResource StatusWarnTextColor}" />
    <SolidColorBrush x:Key="StatusWarnMidBrush" Color="{StaticResource StatusWarnMidColor}" />
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="{StaticResource StatusWarnBgColor}" />

    <!-- Problème / Critique -->
    <Color x:Key="StatusBadTextColor">#9E4655</Color>
    <Color x:Key="StatusBadMidColor">#C85668</Color>
    <Color x:Key="StatusBadBgColor">#F3B8C0</Color>
    <SolidColorBrush x:Key="StatusBadTextBrush" Color="{StaticResource StatusBadTextColor}" />
    <SolidColorBrush x:Key="StatusBadMidBrush" Color="{StaticResource StatusBadMidColor}" />
    <SolidColorBrush x:Key="StatusBadBgBrush" Color="{StaticResource StatusBadBgColor}" />

    <!-- ============================================================
         RAYONS DE BORDURE
         ============================================================ -->
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">16</CornerRadius>
    <CornerRadius x:Key="RadiusLg">20</CornerRadius>

    <!--
        ATTENTION : WinUI 3 a des bugs de rendu documentés (issues GitHub
        microsoft-ui-xaml #6207, #8313, #6475) quand un CornerRadius déclaré
        est très disproportionné par rapport à la taille réelle de l'élément
        (ex. 999 sur un élément large de 10-70px) — le clamp automatique vers
        la moitié de la plus petite dimension ne se fait pas proprement et
        produit des arcs en pointe plutôt qu'un arrondi plein.
        Ne pas réutiliser RadiusPill tel quel pour un nouveau composant "pilule" :
        calculer et déclarer la valeur exacte (moitié de la plus petite
        dimension réelle) à la place. Voir RadiusBarPill ci-dessous pour
        l'exemple (barres/capsules de 10px de haut).
    -->
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Radius exact pour les barres/capsules de 10px (Stockage, Charge, Températures) -->
    <CornerRadius x:Key="RadiusBarPill">5</CornerRadius>

    <!-- ============================================================
         ÉCHELLE TYPOGRAPHIQUE
         ============================================================ -->
    <x:Double x:Key="FontSize1">11</x:Double>
    <x:Double x:Key="FontSize2">13</x:Double>
    <x:Double x:Key="FontSize3">14</x:Double>
    <x:Double x:Key="FontSize4">16</x:Double>
    <x:Double x:Key="FontSize5">20</x:Double>
    <x:Double x:Key="FontSize6">24</x:Double>
    <x:Double x:Key="FontSize7">32</x:Double>

    <!-- ============================================================
         POLICES
         ATTENTION : Nunito et JetBrains Mono ne sont pas des polices Windows
         par défaut. Fichiers .ttf à ajouter dans Assets/Fonts/ avant que ces
         FontFamily ne fonctionnent réellement (sinon fallback silencieux vers
         une police système).
         ============================================================ -->
    <FontFamily x:Key="BodyFontFamily">/Assets/Fonts/Nunito-Regular.ttf#Nunito</FontFamily>
    <FontFamily x:Key="MonoFontFamily">/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>

</ResourceDictionary>
