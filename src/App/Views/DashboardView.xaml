<UserControl
    x:Class="Canopus.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Canopus.App.Models"
    xmlns:controls="using:Canopus.App.Controls"
    xmlns:loc="using:Canopus.App.Localization">

    <ScrollViewer>
        <StackPanel Padding="20,12,32,32" Spacing="20">

            <!-- En-tête -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Dashboard.Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{loc:Loc Key=Dashboard.Subtitle}" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"
                        Content="{loc:Loc Key=Dashboard.GameSessionButton}" Click="OnGameSessionClick" />
            </Grid>

            <!-- Niveau 2 : processeur et carte graphique -->
            <Border Style="{StaticResource SurfaceL2CardStyle}" Padding="28,24">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14">
                        <Grid>
                            <TextBlock Text="{loc:Loc Key=Dashboard.Cpu.Title}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Cpu.StatusText, Mode=OneWay}" Style="{StaticResource CaptionStrongStyle}"
                                       Foreground="{x:Bind ViewModel.Cpu.StatusBrush, Mode=OneWay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Cpu.Temperature, Mode=OneWay}" Style="{StaticResource DisplayValueStyle}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=Unit.Celsius}" Style="{StaticResource DisplayUnitStyle}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Cpu.FrequencyText, Mode=OneWay}"
                                       Style="{StaticResource LabelStrongStyle}" FontSize="{StaticResource FontSize16}"
                                       TextLineBounds="TrimToBaseline" TextWrapping="NoWrap"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="{loc:Loc Key=Dashboard.Load}" Style="{StaticResource LabelStrongStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Cpu.LoadText, Mode=OneWay}" Style="{StaticResource LabelStrongStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <controls:DataBar Height="8" CornerRadius="{StaticResource RadiusBar}" Fill="{StaticResource DataBarBrush}"
                                              Value="{x:Bind ViewModel.Cpu.LoadFraction, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Cpu.Name, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" />

                    <StackPanel Grid.Column="2" Spacing="14">
                        <Grid>
                            <TextBlock Text="{loc:Loc Key=Dashboard.Gpu.Title}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Gpu.StatusText, Mode=OneWay}" Style="{StaticResource CaptionStrongStyle}"
                                       Foreground="{x:Bind ViewModel.Gpu.StatusBrush, Mode=OneWay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.Gpu.Temperature, Mode=OneWay}" Style="{StaticResource DisplayValueStyle}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=Unit.Celsius}" Style="{StaticResource DisplayUnitStyle}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Gpu.FrequencyText, Mode=OneWay}"
                                       Style="{StaticResource LabelStrongStyle}" FontSize="{StaticResource FontSize16}"
                                       TextLineBounds="TrimToBaseline" TextWrapping="NoWrap"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="{loc:Loc Key=Dashboard.Load}" Style="{StaticResource LabelStrongStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Gpu.LoadText, Mode=OneWay}" Style="{StaticResource LabelStrongStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <controls:DataBar Height="8" CornerRadius="{StaticResource RadiusBar}" Fill="{StaticResource DataBarBrush}"
                                              Value="{x:Bind ViewModel.Gpu.LoadFraction, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Gpu.Name, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Niveau 1 : réseau, mémoire et disques, processus -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SurfaceL1CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc Key=Dashboard.Network.Title}" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.LatencyValue, Mode=OneWay}" Style="{StaticResource MetricValueStyle}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{loc:Loc Key=Unit.Milliseconds}" Style="{StaticResource MetricUnitStyle}"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.JitterText, Mode=OneWay}" Style="{StaticResource LabelStrongStyle}" />
                        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.NetworkFootnote}" Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SurfaceL1CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Loc Key=Dashboard.Memory.Title}" Style="{StaticResource CardTitleStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.MemoryRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:UsageDisplayItem">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource TextBoldStyle}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ValueText, Mode=OneWay}"
                                                       Style="{StaticResource LabelStrongStyle}" TextWrapping="NoWrap" />
                                        </Grid>
                                        <controls:DataBar Height="6" CornerRadius="{StaticResource RadiusBarThin}"
                                                          Fill="{StaticResource DataBarStrongBrush}"
                                                          Value="{x:Bind Fraction, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceL1CardStyle}">
                    <StackPanel>
                        <Grid ColumnSpacing="12" Padding="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Dashboard.Processes.Title}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=Dashboard.Processes.Cpu}" Style="{StaticResource CaptionStrongStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc Key=Dashboard.Processes.Ram}" Style="{StaticResource CaptionStrongStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessDisplayItem">
                                    <Grid ColumnSpacing="12" Height="38" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource TextBoldStyle}" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind CpuText}" Style="{StaticResource BodyStyle}"
                                                   TextWrapping="NoWrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind MemoryText}" Style="{StaticResource BodyStyle}"
                                                   TextWrapping="NoWrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Niveau 0 : résumé de l'audit, sans barre -->
            <StackPanel Orientation="Horizontal" Spacing="16" Padding="4,6">
                <TextBlock Text="{x:Bind ViewModel.AuditSummaryText, Mode=OneWay}" Style="{StaticResource CardTitleStyle}"
                           Foreground="{x:Bind ViewModel.AuditSummaryBrush, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc Key=Dashboard.AuditSummary.Source}" Style="{StaticResource BodyStyle}"
                           Visibility="{x:Bind ViewModel.AuditSourceVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                <Button Style="{StaticResource LinkButtonStyle}" Click="OnAuditClick" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc Key=Dashboard.AuditSummary.ViewAudit}">
                    <TextBlock Text="{loc:Loc Key=Dashboard.AuditSummary.ViewAudit}" TextDecorations="Underline"
                               Style="{StaticResource TextExtraBoldStyle}" Foreground="{StaticResource AccentBrush}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
