<UserControl
    x:Class="Canopus.App.Views.GameSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Canopus.App.Models"
    xmlns:loc="using:Canopus.App.Localization">

    <UserControl.Resources>
        <!-- Case « Exclure de la session » : 18 px, coins de 4 px, cochée en accent -->
        <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="CheckboxUncheckedBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="SecondaryButtonHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="SecondaryButtonHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="TextTertiaryBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="TextTertiaryBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="TextTertiaryBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentPressedBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentPressedBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="TextOnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="TextOnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="TextOnAccentBrush" />
        <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="TextTertiaryBrush" />
        <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="TextTertiaryBrush" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Padding="20,12,32,32" Spacing="20">

            <TextBlock Text="{loc:Loc Key=GameSession.Title}" Style="{StaticResource PageTitleStyle}" />

            <!-- Niveau 2 : démarrer ou arrêter, avec le message de retour -->
            <Border Style="{StaticResource SurfaceL2CardStyle}">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}" Style="{StaticResource HeroTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}" Style="{StaticResource BodyLargeStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource HeroButtonStyle}" VerticalAlignment="Center"
                                Content="{x:Bind ViewModel.ToggleButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanToggle, Mode=OneWay}"
                                Click="OnToggleSessionClick" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <TextBlock Text="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" Style="{StaticResource TextBoldStyle}"
                                   Foreground="{x:Bind ViewModel.FeedbackBrush, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Niveau 1 : les réglages de la session -->
            <Border Style="{StaticResource SurfaceL1CardStyle}" Padding="0,4">
                <ItemsControl ItemsSource="{x:Bind ViewModel.TweakStatuses, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TweakStatusDisplayItem">
                            <Grid ColumnSpacing="20" Padding="22,16"
                                  BorderBrush="{StaticResource DividerBrush}" BorderThickness="{x:Bind DividerThickness}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStrongStyle}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyStyle}" />
                                    <TextBlock Text="{x:Bind FailureReason}" Visibility="{x:Bind FailureVisibility}"
                                               Style="{StaticResource TextBoldStyle}" Foreground="{StaticResource StatusBadTextBrush}" />
                                    <CheckBox Content="{loc:Loc Key=GameSession.ExcludeCheckbox}"
                                              Visibility="{x:Bind ExcludeVisibility}"
                                              IsChecked="{x:Bind IsExcluded}"
                                              IsEnabled="{x:Bind IsExcludeEnabled}"
                                              Checked="OnExcludeToggled"
                                              Unchecked="OnExcludeToggled"
                                              FontFamily="{StaticResource FontFamilyBold}" FontWeight="Bold"
                                              FontSize="{StaticResource FontSize14}"
                                              CornerRadius="{StaticResource RadiusCheckbox}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource ChipStyle}" MinHeight="24" Padding="9,0"
                                        VerticalAlignment="Top" Background="{x:Bind StatusBgBrush}">
                                    <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ChipTextStyle}"
                                               Foreground="{x:Bind StatusTextBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
