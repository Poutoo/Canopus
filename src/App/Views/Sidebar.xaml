<UserControl
    x:Class="Canopus.App.Views.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Canopus.App.Localization">

    <!-- 224 px au total : 208 px de volet + 8 px de marge de chaque côté -->
    <Border Style="{StaticResource SurfaceNavStyle}" Width="208" Margin="8,0,8,8">
        <Grid x:Name="ItemsHost" SizeChanged="OnItemsHostSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Indicateur de l'item actif : fond Dragée + repère en encre, déplacé par translation Composition -->
            <Border x:Name="ActiveIndicator" Grid.RowSpan="3" Height="40" VerticalAlignment="Top"
                    CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource NavItemActiveBrush}"
                    IsHitTestVisible="False">
                <Border Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusNavMarker}" Background="{StaticResource NavMarkerBrush}" />
            </Border>

            <StackPanel Grid.Row="0" Spacing="4" XYFocusKeyboardNavigation="Enabled">
                <Button x:Name="DashboardItem" Style="{StaticResource NavItemStyle}" Click="OnNavItemClick"
                        AutomationProperties.Name="{loc:Loc Key=Nav.Dashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="DashboardIcon" Style="{StaticResource NavIconStyle}"
                                      Data="M4.6,3 H8.4 A1.6,1.6 0 0 1 10,4.6 V10.4 A1.6,1.6 0 0 1 8.4,12 H4.6 A1.6,1.6 0 0 1 3,10.4 V4.6 A1.6,1.6 0 0 1 4.6,3 Z M15.6,3 H19.4 A1.6,1.6 0 0 1 21,4.6 V6.4 A1.6,1.6 0 0 1 19.4,8 H15.6 A1.6,1.6 0 0 1 14,6.4 V4.6 A1.6,1.6 0 0 1 15.6,3 Z M15.6,12 H19.4 A1.6,1.6 0 0 1 21,13.6 V19.4 A1.6,1.6 0 0 1 19.4,21 H15.6 A1.6,1.6 0 0 1 14,19.4 V13.6 A1.6,1.6 0 0 1 15.6,12 Z M4.6,16 H8.4 A1.6,1.6 0 0 1 10,17.6 V19.4 A1.6,1.6 0 0 1 8.4,21 H4.6 A1.6,1.6 0 0 1 3,19.4 V17.6 A1.6,1.6 0 0 1 4.6,16 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="DashboardLabel" Text="{loc:Loc Key=Nav.Dashboard}" Style="{StaticResource NavLabelStyle}" />
                    </StackPanel>
                </Button>

                <Button x:Name="AuditItem" Style="{StaticResource NavItemStyle}" Click="OnNavItemClick"
                        AutomationProperties.Name="{loc:Loc Key=Nav.Audit}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="AuditIcon" Style="{StaticResource NavIconStyle}"
                                      Data="M7,4 H17 A2,2 0 0 1 19,6 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V6 A2,2 0 0 1 7,4 Z M9,4 V3 H15 V4 M9,12.5 L11,14.5 L15,10.5" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="AuditLabel" Text="{loc:Loc Key=Nav.Audit}" Style="{StaticResource NavLabelStyle}" />
                    </StackPanel>
                </Button>

                <Button x:Name="GameSessionItem" Style="{StaticResource NavItemStyle}" Click="OnNavItemClick"
                        AutomationProperties.Name="{loc:Loc Key=Nav.GameSession}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="GameSessionIcon" Style="{StaticResource NavIconStyle}"
                                      Data="M7.5,7 H16.5 A5,5 0 0 1 21.5,12 V13 A5,5 0 0 1 16.5,18 H7.5 A5,5 0 0 1 2.5,13 V12 A5,5 0 0 1 7.5,7 Z M7.5,10.5 V14.5 M5.5,12.5 H9.5 M14.6,11.5 A0.9,0.9 0 1 0 16.4,11.5 A0.9,0.9 0 1 0 14.6,11.5 Z M16.6,13.5 A0.9,0.9 0 1 0 18.4,13.5 A0.9,0.9 0 1 0 16.6,13.5 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="GameSessionLabel" Text="{loc:Loc Key=Nav.GameSession}" Style="{StaticResource NavLabelStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="ParametresItem" Grid.Row="2" Style="{StaticResource NavItemStyle}" Click="OnNavItemClick"
                    AutomationProperties.Name="{loc:Loc Key=Nav.Parametres}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ParametresIcon" Style="{StaticResource NavIconStyle}"
                                  Data="M4,7 H13 M17,7 H20 M12.6,7 A2.4,2.4 0 1 0 17.4,7 A2.4,2.4 0 1 0 12.6,7 Z M4,17 H7 M11,17 H20 M6.6,17 A2.4,2.4 0 1 0 11.4,17 A2.4,2.4 0 1 0 6.6,17 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ParametresLabel" Text="{loc:Loc Key=Nav.Parametres}" Style="{StaticResource NavLabelStyle}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
