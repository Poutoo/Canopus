<UserControl
    x:Class="Canopus.App.Views.ParametresView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:loc="using:Canopus.App.Localization">

    <ScrollViewer>
        <StackPanel Padding="20,12,32,32" Spacing="20" MaxWidth="812" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Loc Key=Parametres.Title}" Style="{StaticResource PageTitleStyle}" />

            <!-- Niveau 2 : démarrage -->
            <Border Style="{StaticResource SurfaceL2CardStyle}" Padding="0,20,0,8">
                <StackPanel>
                    <StackPanel Spacing="4" Padding="24,0,24,12">
                        <TextBlock Text="{loc:Loc Key=Parametres.Startup.Title}" Style="{StaticResource GroupTitleStyle}" />
                        <TextBlock Text="{loc:Loc Key=Parametres.Startup.Description}" Style="{StaticResource BodyStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" MinHeight="56" Padding="24,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Parametres.Startup.LaunchAtStartup}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{loc:Loc Key=Parametres.Startup.LaunchAtStartupDescription}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource BareToggleSwitchStyle}"
                                      AutomationProperties.Name="{loc:Loc Key=Parametres.Startup.LaunchAtStartup}"
                                      IsOn="{x:Bind ViewModel.LaunchAtStartupEnabled, Mode=OneWay}"
                                      Toggled="OnLaunchAtStartupToggled" />
                    </Grid>

                    <Grid ColumnSpacing="16" MinHeight="56" Padding="24,8" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Parametres.Startup.MinimizeToTray}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{loc:Loc Key=Parametres.Startup.MinimizeToTrayDescription}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource BareToggleSwitchStyle}"
                                      AutomationProperties.Name="{loc:Loc Key=Parametres.Startup.MinimizeToTray}"
                                      IsOn="{x:Bind ViewModel.MinimizeToTrayEnabled, Mode=OneWay}"
                                      Toggled="OnMinimizeToTrayToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Niveau 1 : session de jeu -->
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc Key=Parametres.GameSession.Title}" Style="{StaticResource CardTitleStyle}" Padding="4,0,0,0" />
                <Border Style="{StaticResource SurfaceL1CardStyle}" Padding="20,8" MinHeight="56">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=Parametres.MousePrecision.Title}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{loc:Loc Key=Parametres.MousePrecision.Description}" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource BareToggleSwitchStyle}"
                                      AutomationProperties.Name="{loc:Loc Key=Parametres.MousePrecision.Title}"
                                      IsOn="{x:Bind ViewModel.MousePrecisionEnabled, Mode=OneWay}"
                                      Toggled="OnMousePrecisionToggled" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Niveau 1 : langue -->
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc Key=Parametres.Language.Title}" Style="{StaticResource CardTitleStyle}" Padding="4,0,0,0" />
                <Border Style="{StaticResource SurfaceL1CardStyle}" Padding="0">
                    <StackPanel>
                        <Grid ColumnSpacing="16" MinHeight="56" Padding="20,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Parametres.Language.Interface}" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />

                            <Grid Grid.Column="1" VerticalAlignment="Center" Padding="3"
                                  CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource SegmentTrackBrush}"
                                  BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                  XYFocusKeyboardNavigation="Enabled">
                                <Border x:Name="LanguageThumb" Width="96" Height="28" HorizontalAlignment="Left"
                                        CornerRadius="{StaticResource RadiusSegmentThumb}" Background="{StaticResource SegmentThumbBrush}"
                                        ui:Effects.Shadow="{StaticResource ShadowSegmentThumb}" IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FrenchSegment" Style="{StaticResource SegmentButtonStyle}" Click="OnLanguageSegmentClick"
                                            AutomationProperties.Name="{loc:Loc Key=Parametres.Language.French}">
                                        <TextBlock x:Name="FrenchLabel" Text="{loc:Loc Key=Parametres.Language.French}" Style="{StaticResource SegmentLabelStyle}" />
                                    </Button>
                                    <Button x:Name="EnglishSegment" Style="{StaticResource SegmentButtonStyle}" Click="OnLanguageSegmentClick"
                                            AutomationProperties.Name="{loc:Loc Key=Parametres.Language.English}">
                                        <TextBlock x:Name="EnglishLabel" Text="{loc:Loc Key=Parametres.Language.English}" Style="{StaticResource SegmentLabelStyle}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid ColumnSpacing="16" Padding="20,10,20,14" Visibility="{x:Bind ViewModel.LanguageRestartVisibility, Mode=OneWay}"
                              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=Parametres.Language.RestartNeeded}" Style="{StaticResource TextBoldStyle}"
                                       Foreground="{StaticResource StatusWarnTextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource PrimarySmallButtonStyle}"
                                    Content="{loc:Loc Key=Parametres.Language.RestartButton}" Click="OnRestartNowClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Niveau 0 : version et mises à jour -->
            <Grid ColumnSpacing="16" Padding="4,8" BorderBrush="{StaticResource DividerStrongBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" Style="{StaticResource RowTitleStrongStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" Style="{StaticResource CaptionStyle}"
                               Foreground="{x:Bind ViewModel.UpdateStatusBrush, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.UpdateStatusVisibility, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondarySmallButtonStyle}" Content="{loc:Loc Key=Parametres.Updates.CheckNow}"
                            Click="OnCheckForUpdatesClick"
                            Visibility="{x:Bind ViewModel.CheckButtonVisibility, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                    <Button Style="{StaticResource PrimarySmallButtonStyle}" Height="34" Padding="16,0"
                            Content="{loc:Loc Key=Parametres.Updates.Install}"
                            Click="OnInstallUpdateClick"
                            Visibility="{x:Bind ViewModel.InstallButtonVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
