<Window
    x:Class="Canopus.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Canopus.App.Views"
    xmlns:loc="using:Canopus.App.Localization">

    <Grid x:Name="RootGrid" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Zone de glisser : toute la ligne, les boutons système se posent par-dessus -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource TransparentBrush}">
            <StackPanel x:Name="AppTitleContent" Orientation="Horizontal" Spacing="10" Padding="20,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/canopus-icone/png/couleur-clair/canopus-48.png" Width="24" Height="24" />
                <TextBlock Text="{loc:Loc Key=App.Name}" Style="{StaticResource TextExtraBoldStyle}"
                           FontSize="{StaticResource FontSize14}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <local:Sidebar x:Name="NavSidebar" Grid.Row="1" Grid.Column="0" NavigationRequested="OnNavigationRequested" />

        <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1">
            <local:DashboardView x:Name="DashboardPage" AuditRequested="OnAuditRequested" GameSessionRequested="OnGameSessionRequested" />
            <local:AuditView x:Name="AuditPage" Visibility="Collapsed" />
            <local:GameSessionView x:Name="GameSessionPage" Visibility="Collapsed" />
            <local:ParametresView x:Name="ParametresPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
