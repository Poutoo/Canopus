<Window
    x:Class="Canopus.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Canopus.App.Views">

    <Grid Background="{StaticResource BackdropFallbackBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:Sidebar x:Name="NavSidebar" Grid.Column="0" NavigationRequested="OnNavigationRequested" />

        <Grid Grid.Column="1">
            <local:DashboardView x:Name="DashboardPage" AuditRequested="OnAuditRequested" GameSessionRequested="OnGameSessionRequested" />
            <local:AuditView x:Name="AuditPage" Visibility="Collapsed" />
            <local:GameSessionView x:Name="GameSessionPage" Visibility="Collapsed" />
            <local:ParametresView x:Name="ParametresPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
