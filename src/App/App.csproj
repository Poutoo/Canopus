<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Canopus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\canopus-icone\ico\canopus-clair.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Déploiement unpackaged, validé par le spike -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Main généré manuellement dans Program.cs pour pouvoir appeler
         VelopackApp.Build().Run() avant tout le reste (requis par Velopack). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- WMI (Win32_PhysicalMemory, Win32_VideoController, MSFT_MpPreference) -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <!-- Zone de notification (system tray). 2.3.2, pas 2.4.1 : la 2.4.x relève son TFM minimum
         à net10.0-windows, incompatible avec notre net8.0-windows, donc 2.3.2 est la plus
         récente version stable (pas -dev/-beta) que ce projet puisse réellement consommer.
         IconSource utilise GeneratedIconSource (texte, pas un fichier .ico chargé via ms-appx://) :
         un bug connu de la lib fait planter le clic droit sur l'icône dans une app unpackaged
         quand l'icône est chargée depuis un ms-appx URI
         (https://github.com/HavenDV/H.NotifyIcon/issues/23, /issues/37). -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- AttachedCardShadow : ombre masquée sous la card, sinon elle transparaît
         à travers les surfaces translucides. -->
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\canopus-icone\ico\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\canopus-icone\png\couleur-clair\canopus-48.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dictionnaires de traduction FR/EN, embarqués dans l'assembly (pas Content copié à
       côté de l'exe) : ce sont des données figées au build, voir Localization/. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings\*.json" />
  </ItemGroup>

  <!-- `dotnet publish` of an unpackaged WinUI app leaves out App.pri and the compiled XAML
       (.xbf): the published exe then crashes at startup with a stowed XAML exception. -->
  <Target Name="IncludeXamlOutputsInPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <XamlOutput Include="$(OutDir)App.pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(XamlOutput)"
                             RelativePath="$([MSBuild]::MakeRelative('$(OutDir)', '%(XamlOutput.FullPath)'))"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
